{
  "manifest_version": 3,
  "name": "Alertix URL Logger",
  "version": "1.0",
  "description": "Logs visited URLs to Alertix SIEM",
  "permissions": [
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}